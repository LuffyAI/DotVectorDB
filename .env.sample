##################################################
# DotVectorDB Graph Construction Configurations  #
##################################################
# Change the default summary language for entity and relationship descriptions.
DEFAULT_SUMMARY_LANGUAGE = "English"

# The LLM will be prompted to generate descriptions of token size 'RECOMMENDED_MAX_ENTITY_RELATION_DESCRIPTION_TOKEN_SIZE'.
# If an entity description ever exceeds 'MAX_ENTITY_RELATION_DESCRIPTION_TOKEN_SIZE', the LLM will be prompted to summarize the description to fit within 'RECOMMENDED_MAX_ENTITY_RELATION_DESCRIPTION_TOKEN_SIZE'.
MAX_ENTITY_RELATION_DESCRIPTION_TOKEN_SIZE = 1200
RECOMMENDED_ENTITY_RELATION_DESCRIPTION_TOKEN_SIZE = 600

# MAX_ENTITY_QUESTIONS restrict the number of question predictions for each entity.
# MAX_ENTITY_QUESTIONS_TOKEN_SIZE restricts the total token size of all questions for each entity.
MAX_ENTITY_QUESTIONS = 8
MAX_ENTITY_QUESTIONS_TOKEN_SIZE = 160

# MAX_ENTITY_KEYWORDS restricts the number of keyword predictions for each entity.
# MAX_ENTITY_KEYWORDS_TOKEN_SIZE restricts the total token size of all keywords for each entity
MAX_RELATION_QUESTIONS = 8
MAX_RELATION_QUESTIONS_TOKEN_SIZE = 160

# MAX_RELATION_KEYWORDS restricts the number of keyword predictions for each relationship.
# MAX_RELATION_KEYWORDS_TOKEN_SIZE restricts the total token size of all keywords for each
MAX_RELATION_KEYWORDS = 8
MAX_RELATION_KEYWORDS_TOKEN_SIZE = 48

# MAX_QUESTION_TOKEN_SIZE restricts the maximum token size of each question.
# MAX_KEYWORD_TOKEN_SIZE restricts the maximum token size of each keyword.
MAX_QUESTION_TOKEN_SIZE = 32
MAX_KEYWORD_TOKEN_SIZE = 8

# Hugging Face Token
HF_TOKEN=""

# OpenAI API Credentials
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-large"
OPENAI_EMBEDDING_DIM=3072
OPENAI_LLM_MODEL="gpt-4o-mini"
OPENAI_LLM_TOKENIZER="gpt-4o"
OPENAI_LLM_MAX_TOKENS=10000
OPENAI_EMBEDDING_MODEL_MAX_TOKENS=8192
OPENAI_EMBEDDING_MODEL="text-embedding-3-large"

# OpenRouter API Credentials
OPENROUTER_API_KEY=""
OPENROUTER_EMBEDDING_MODEL="baai/bge-large-en-v1.5"
OPENROUTER_EMBEDDING_DIM=1536
OPENROUTER_LLM_MODEL="meta-llama/llama-3.1-8b-instruct"

# Antropic API Credentials
ANTROPIC_API_KEY=""
ANTROPIC_EMBEDDING_DIM=1536
ANTROPIC_LLM_MODEL="claude-3.0"
ANTROPIC_LLM_MAX_TOKENS=8192

# Gemini API Credentials
GEMINI_API_KEY=""
GEMINI_EMBEDDING_DIM=1536
GEMINI_LLM_MODEL="gemini-3.5-flash"
GEMINI_LLM_MAX_TOKENS=8192

